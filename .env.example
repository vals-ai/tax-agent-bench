# Copy to .env and fill in the keys you need:  cp .env.example .env
# The .env file takes precedence over environment variables already set.

# === Model API Keys (set only the one for the provider you are running) ===
# Resolved by the model library from the --model you pass, e.g.
# --model anthropic/claude-sonnet-4-6 needs ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# === Agent Tools (REQUIRED) ===
# The web_search tool refuses to start without this. Create a key at https://tavily.com/
TAVILY_API_KEY=
